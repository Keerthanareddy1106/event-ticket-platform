# Optional: Set to "false" to disable standalone Recruiter Demo Mode and require Keycloak + Spring Boot
VITE_DEMO_MODE=true

# Optional: External Spring Boot API base URL (leave empty to use local Vite proxy or Demo Store on Vercel)
VITE_API_BASE_URL=

# Optional: External Keycloak OIDC configuration
VITE_OIDC_AUTHORITY=http://localhost:9090/realms/event-ticket-platform
VITE_OIDC_CLIENT_ID=event-ticket-platform-app
VITE_OIDC_REDIRECT_URI=http://localhost:5173/callback
